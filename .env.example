# ──────────────────────────────────────────────
# West 60 Mwangaza — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# Local dev uses a hardcoded SQLite path — no DATABASE_URL needed.

# ─── NextAuth ─────────────────────────────────
# Secret used to sign JWT sessions. Generate a new one for production:
#   openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-secret"
# Must match your deployment URL (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ─── Public (client-side) ─────────────────────
# Base URL for sitemap, robots.txt, and OpenGraph metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Turso (production database) ──────────────
# Get these from: https://turso.tech → your database → "Connect" tab
# TURSO_DATABASE_URL should start with libsql://
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ─── Cloudflare (optional, for Workers deploy) ─
# Only needed when deploying to Cloudflare Workers
# CLOUDFLARE="1"
# WRANLGE_DEV="1"
